# Runtime defaults for local development
PORT=8080

# Security controls
REQUIRE_SECRETS=true
ADMIN_AUTH_ENABLED=true
ADMIN_JWT_ISSUER=teampulse
ADMIN_JWT_AUDIENCE=teampulse-ops
ADMIN_JWT_SECRET=
ADMIN_ALLOW_CIDRS=
TRUSTED_PROXY_CIDRS=

# Queue backend
QUEUE_BACKEND=log
QUEUE_BUFFER=4096
QUEUE_WORKERS=16
QUEUE_BULKHEAD_ENABLED=true
QUEUE_BULKHEAD_BUFFER_PER_SOURCE=1024
QUEUE_BULKHEAD_MAX_SOURCES=8
QUEUE_BATCH_SIZE=100
QUEUE_BATCH_FLUSH_MS=50
QUEUE_BACKPRESSURE_ENABLED=true
QUEUE_BACKPRESSURE_SOFT_LIMIT_PERCENT=70
QUEUE_BACKPRESSURE_HARD_LIMIT_PERCENT=90
QUEUE_FAILURE_BUDGET_PERCENT=15
QUEUE_FAILURE_BUDGET_WINDOW=100
QUEUE_FAILURE_BUDGET_MIN_SAMPLES=20
QUEUE_THROTTLE_RETRY_AFTER_SEC=2
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=300
ADMIN_RATE_LIMIT_RPM=60
DEDUP_ENABLED=true
DEDUP_TTL_SEC=300
REDIS_POOL_SIZE=32
REDIS_MIN_IDLE_CONNS=8
REDIS_IO_TIMEOUT_MS=100
REDIS_CLUSTER_ADDRS=
RATE_LIMIT_COMBINED=false
PUBSUB_PROJECT_ID=
PUBSUB_TOPIC_ID=
PUBSUB_PUBLISH_TIMEOUT_SEC=5
PUBSUB_PUBLISH_GOROUTINES=16
PUBSUB_MAX_OUTSTANDING_MESSAGES=2000
PUBSUB_MAX_OUTSTANDING_BYTES=104857600
PUBSUB_FLOW_CONTROL_BEHAVIOR=signal_error
PUBSUB_BATCH_DELAY_MS=20
PUBSUB_BATCH_COUNT_THRESHOLD=500
PUBSUB_BATCH_BYTE_THRESHOLD=1048576
CIRCUIT_BREAKER_THRESHOLD=25
CIRCUIT_BREAKER_RECOVERY_SEC=8
PII_SCRUBBING_ENABLED=false
PII_SCRUB_ASYNC=true
PII_MAX_SCRUB_BYTES=262144
HTTP_MAX_INFLIGHT=512
HTTP_MAX_HEADER_BYTES=8192
HTTP_H2C_ENABLED=false
OTEL_TRACES_SAMPLER_RATIO=0.02
RETRY_WORKERS=8
EVENTSTORE_PUBSUB_SUBSCRIPTION_ID=webhook-events-store
EVENTSTORE_MAX_OUTSTANDING_MESSAGES=2000
EVENTSTORE_MAX_OUTSTANDING_BYTES=268435456
EVENTSTORE_RECEIVE_GOROUTINES=16
EVENTSTORE_MAX_EXTENSION_SEC=600
EVENTSTORE_DB_MAX_CONNS=32
EVENTSTORE_DB_MIN_CONNS=8
FAILED_EVENT_STORE_ENABLED=true
FAILED_EVENT_STORE_PATH=data/failed-events.jsonl
REPLAY_AUDIT_ENABLED=true
REPLAY_AUDIT_PATH=data/replay-audit.jsonl
SECURITY_AUDIT_ENABLED=true
SECURITY_AUDIT_PATH=data/security-audit.jsonl
SECURITY_AUDIT_RETENTION_DAYS=30

# Webhook secret placeholders
SLACK_SIGNING_SECRET=
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_TOKEN=
TEAMS_CLIENT_STATE=

# Observability
ENVIRONMENT=local
OTEL_EXPORTER_OTLP_ENDPOINT=

# Grafana (must be changed from defaults)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
